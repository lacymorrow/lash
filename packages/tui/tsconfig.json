{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["../opencode/src/*"],
      "@shell-mode": ["../opencode/plugin/shell-mode/index.ts"],
      "@shell-mode/*": ["../opencode/plugin/shell-mode/*"],
      "@tui-integration": ["../opencode/plugin/tui-integration/index.ts"],
      "@tui-integration/*": ["../opencode/plugin/tui-integration/*"]
    }
  }
}
